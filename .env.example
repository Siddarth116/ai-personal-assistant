# SQLite database - for local dev this is a plain file. For production on
# Vercel, point this at a Turso database instead (see README for setup):
#   DATABASE_URL=libsql://your-db-name.turso.io
#   DATABASE_AUTH_TOKEN=your-turso-auth-token
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# Secret used to sign session cookies - set to any long random string
AUTH_SECRET=change-this-to-a-long-random-string

# --- AI assistant (optional) ---
# Without these set, the app runs fine but the AI assistant will show
# "AI features are not configured."

# Option A: OpenAI (default)
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini

# Option B: Google Gemini via its free OpenAI-compatible endpoint
# Get a key at https://aistudio.google.com/apikey
#   OPENAI_API_KEY=your-google-ai-studio-key
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
